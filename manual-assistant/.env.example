# Manual Assistant settings. Copy to .env and edit.
#
#     cp .env.example .env
#
# Everything here is read by docker-compose.yml. Running without Docker, export
# the same names in your shell.

# ---------------------------------------------------------------- required

# The domain the app is served on. Caddy requests a certificate for exactly this
# name, so it must already point at this server. Use localhost to try it without
# a domain; the browser will then warn about the certificate once.
APP_DOMAIN=manuals.example.com

# Signs the session cookies. Generate one and keep it secret. Changing it signs
# everyone out.
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# ---------------------------------------------------------------- models
#
# These three are all that change to move from the local model to a cloud one.
# For Ollama in compose, leave them as they are. For a cloud provider, set
# LLM_BASE_URL to its OpenAI-compatible endpoint, LLM_API_KEY to your key and
# LLM_MODEL to the model name. Keep EMBED_BASE_URL on Ollama unless the provider
# also serves bge-m3.

# Left blank, these default to the ollama service inside compose.
LLM_BASE_URL=
LLM_API_KEY=not-needed-for-ollama
LLM_MODEL=llama3.1:8b

EMBED_BASE_URL=
EMBED_MODEL=bge-m3

# Seconds before a model call is abandoned. A long manual answer on a small
# server can take a while; a request that never returns must still not hang.
LLM_TIMEOUT_S=120
EMBED_TIMEOUT_S=60

# ---------------------------------------------------------------- users
#
# Users can live in a file on the data volume (USERS_FILE, the default
# /data/users.yaml) or inline here. The inline form wins if it is set.
# Generate a hash with:
#     python -m app.auth hash
#
# USERS_YAML="users:\n  - username: admin\n    role: admin\n    password_hash: \"$2b$12$...\"\n"
USERS_YAML=

# ---------------------------------------------------------------- behaviour

# 1 marks the session cookie Secure, which is correct behind HTTPS. Set to 0 only
# when trying the app over plain http on your own machine.
COOKIE_SECURE=1

# Questions kept in the log before the daily sweep deletes them. 0 turns the
# sweep off and keeps everything.
RETENTION_DAYS=90

# Questions one user may ask per minute.
RATE_LIMIT_PER_MINUTE=20

# Largest PDF accepted by the upload form, in megabytes.
MAX_UPLOAD_MB=200

# DEBUG, INFO, WARNING or ERROR. Logs are JSON, one object per line, on stdout.
LOG_LEVEL=INFO

# ------------------------------------------- only when running without Docker
#
# In Docker these are set in docker-compose.yml and should be left alone here.
#
# HOST=127.0.0.1
# PORT=8000
# DATA_DIR=./data
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# EMBED_BASE_URL=http://127.0.0.1:11434
